# Skopiuj do apps/api/.env do pracy lokalnej (npm run dev:api). W Coolify ustaw te same zmienne
# w ustawieniach usługi. Adres webhooka to sekret: nie commituj go i nie wklejaj w kod frontendu.

# Webhook kanału Discord (Ustawienia kanału → Integracje → Webhooki). Wymagane.
DISCORD_WEBHOOK_URL=

# ID użytkowników Discord oznaczanych przy nowym zgłoszeniu, po przecinku (opcjonalne).
# ID: Ustawienia → Zaawansowane → Tryb dewelopera, potem PPM na użytkowniku → Kopiuj ID.
DISCORD_MENTION_USER_IDS=

# Nazwa nadawcy wiadomości na kanale (opcjonalne).
DISCORD_USERNAME=Twoja Budka

# Port HTTP usługi.
PORT=3000

# Limit zgłoszeń z jednego IP: RATE_LIMIT_MAX w oknie RATE_LIMIT_WINDOW_MS (ms).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Ile serwerów proxy dopisuje się do X-Forwarded-For przed API (nginx + Traefik w Coolify = 2).
# 0 = ignoruj nagłówek i bierz adres połączenia (praca lokalna bez proxy).
TRUST_PROXY_HOPS=0
