# Zmienne dla `docker compose up` (skopiuj do .env). W Coolify ustaw je w zakładce Environment Variables.
# Opis każdej zmiennej: apps/api/.env.example. Adres webhooka to sekret — nie commituj go.
DISCORD_WEBHOOK_URL=
DISCORD_MENTION_USER_IDS=
DISCORD_USERNAME=Twoja Budka
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Umami (analityka). Puste = wyłączone. ID strony: Umami → Settings → Websites → Edit.
UMAMI_URL=https://stats.twojabudka.pl
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
